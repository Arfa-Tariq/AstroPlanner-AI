# Copy to .env and fill in — api.py loads this via python-dotenv before
# importing orchestrator, which reads these at import time.

SUPABASE_URL=
SUPABASE_KEY=
GROQ_API_KEY=

# Project Settings -> Database -> Connection string (URI tab). Optional —
# orchestrator falls back to in-memory (non-persistent) checkpointing if
# this isn't set, which is fine for local dev but loses conversation
# state on restart.
DATABASE_URL=
